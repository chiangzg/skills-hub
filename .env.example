# Skills Platform 环境变量配置
# 复制此文件为 .env 并填写实际值

# JWT 密钥（请更改为随机字符串，至少32字符）
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# 数据库加密密钥（用于加密 access_token 等敏感数据）
# 生成命令: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 必须是 32 位 base64 编码字符串，示例: ODDk-VF5dIP2CTZQfJ5dxjf_llAuW9Usk06kvUsbxxo=
ENCRYPTION_KEY=

# MySQL 配置
MYSQL_ROOT_PASSWORD=root_password_change_me
MYSQL_DATABASE=skills
MYSQL_USER=skills
MYSQL_PASSWORD=skills_password

# 数据库连接 URL（Docker 部署时 db 是服务名，本地开发时是 localhost）
DATABASE_URL=mysql+aiomysql://skills:skills_password@db:3306/skills

# 环境配置
ENVIRONMENT=production
